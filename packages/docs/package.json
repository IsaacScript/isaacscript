{
  "name": "docs",
  "private": true,
  "description": "The website for the IsaacScript monorepo.",
  "homepage": "https://isaacscript.github.io/",
  "bugs": {
    "url": "https://github.com/IsaacScript/isaacscript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsaacScript/isaacscript.git"
  },
  "license": "GPL-3.0",
  "author": "Zamiell",
  "scripts": {
    "build": "bun run prepare && astro build",
    "deploy": "bun ./scripts/deploy.mts",
    "dev": "bun run prepare && astro dev",
    "lint": "bun run prepare && astro check && tsc --noEmit --project scripts/tsconfig.json && eslint .",
    "prepare": "bun ./scripts/prepare.mts",
    "start": "bun run dev"
  },
  "dependencies": {
    "@astrojs/starlight": "catalog:",
    "@zamiell/typedoc-plugin-not-exported": "catalog:",
    "astro": "catalog:",
    "sharp": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-frontmatter": "catalog:",
    "typedoc-plugin-markdown": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@types/node": "catalog:",
    "complete-common": "catalog:",
    "complete-node": "catalog:",
    "starlight-links-validator": "catalog:",
    "starlight-typedoc": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}

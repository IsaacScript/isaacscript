{
  "$schema": "https://raw.githubusercontent.com/complete-ts/complete/main/packages/complete-tsconfig/schemas/tsconfig-strict-schema.json",
  "extends": ["complete-tsconfig/tsconfig.base.json"],
  "compilerOptions": {
    "allowJs": true,
    "lib": ["DOM", "ES2023"],
    "moduleResolution": "bundler",
    "rootDir": "..",
    "types": ["astro/client"],
  },
  "include": ["src/**/*.astro", "src/**/*.mjs", "src/**/*.ts"],
}
